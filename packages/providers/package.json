{
  "name": "@actuate/providers",
  "version": "0.1.0",
  "description": "Bring-your-own-credentials provider adapters for Actuate: Telegram, WhatsApp Cloud, Resend, Stripe, Chip, ToyyibPay, Billplz, Anthropic, OpenAI, Google.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/actuate-run/actuate",
    "directory": "packages/providers"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@actuate/sdk": "workspace:*",
    "zod": "^4.6.0"
  },
  "homepage": "https://actuate.run/docs",
  "bugs": {
    "url": "https://github.com/actuate-run/actuate/issues"
  },
  "keywords": [
    "actuate",
    "telegram",
    "whatsapp",
    "stripe",
    "billplz",
    "toyyibpay",
    "chip",
    "fpx"
  ],
  "publishConfig": {
    "access": "public"
  }
}
