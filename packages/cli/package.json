{
  "name": "@actuate/cli",
  "version": "0.4.0",
  "description": "The actuate command: init, dev, test, check, deploy, logs and doctor for Actuate actuators, plus a test harness (@actuate/cli/testing).",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/actuate-run/actuate",
    "directory": "packages/cli"
  },
  "bin": {
    "actuate": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/bin.ts src/index.ts src/testing.ts src/dev-runtime.ts src/test-register.ts src/test-loader.ts --format esm --target node22 --dts --clean --external cloudflare:workers",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@actuate/runtime": "workspace:*",
    "@actuate/sdk": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.40.0",
    "create-actuate": "workspace:*",
    "@actuate/providers": "workspace:*"
  },
  "homepage": "https://actuate.run/docs",
  "bugs": {
    "url": "https://github.com/actuate-run/actuate/issues"
  },
  "keywords": [
    "actuate",
    "cli",
    "workerd",
    "mcp",
    "testing"
  ],
  "publishConfig": {
    "access": "public"
  }
}
