{
  "name": "create-actuate",
  "version": "0.5.0",
  "description": "Scaffold an Actuate actuator: npm create actuate [dir] -- --template <name>",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/actuate-run/actuate",
    "directory": "packages/create-actuate"
  },
  "bin": {
    "create-actuate": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/bin.ts src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "homepage": "https://actuate.run/docs",
  "bugs": {
    "url": "https://github.com/actuate-run/actuate/issues"
  },
  "keywords": [
    "actuate",
    "create",
    "scaffold",
    "template"
  ],
  "publishConfig": {
    "access": "public"
  }
}
